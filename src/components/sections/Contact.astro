---
---

<section id="contact" class="py-20 px-6">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-4xl font-bold mb-12 text-center gradient-text">Get in Touch</h2>
    
    <div class="grid md:grid-cols-2 gap-12">
      <div class="space-y-6">
        <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-200">Let's Connect</h3>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Interested in discussing a project or just want to say hello? I'd love to hear from you.
        </p>
        
        <div class="flex flex-col space-y-4">
          <a 
            href="https://www.linkedin.com/in/neal-borowiak/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center space-x-3 text-gray-600 hover:text-primary-500 transition-colors"
          >
            <img src="/linkedin.svg" alt="LinkedIn" class="w-6 h-6" />
            <span>Connect on LinkedIn</span>
          </a>
          
          <a 
            href="https://github.com/naborowiak" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center space-x-3 text-gray-600 hover:text-primary-500 transition-colors"
          >
            <img src="/github.svg" alt="GitHub" class="w-6 h-6" />
            <span>Follow on GitHub</span>
          </a>
        </div>
      </div>
      
      <form class="space-y-6" data-netlify="true" name="contact">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Name</label>
          <input
            type="text"
            name="name"
            id="name"
            required
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
          />
        </div>
        
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
          <input
            type="email"
            name="email"
            id="email"
            required
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
          />
        </div>
        
        <div>
          <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Message</label>
          <textarea
            name="message"
            id="message"
            rows="4"
            required
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
          ></textarea>
        </div>
        
        <button
          type="submit"
          class="w-full bg-primary-500 text-white px-8 py-3 rounded-lg hover:bg-primary-600 transition-colors"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</section> 