---
const navItems = [
  { href: '#', text: 'Home', active: true },
  { href: '#about', text: 'About' },
  { href: '#portfolio', text: 'Portfolio' },
  { href: '#contact', text: 'Contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50">
  <nav class="backdrop-blur-md bg-white/70 border-b border-gray-200 dark:border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <span class="text-2xl font-bold gradient-text">Neal.dev</span>
        </div>

        <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
          {navItems.map(({ href, text, active }) => (
            <a
              href={href}
              class={`inline-flex items-center px-1 pt-1 text-sm font-medium ${
                active 
                  ? 'text-primary-500 border-b-2 border-primary-500'
                  : 'text-gray-500 hover:text-primary-500 hover:border-b-2 hover:border-primary-500'
              }`}
            >
              {text}
            </a>
          ))}
        </div>

        <div class="flex items-center space-x-4">
          <a href="https://github.com/naborowiak" target="_blank" rel="noopener noreferrer">
            <img src="/github.svg" alt="GitHub" class="w-6 h-6 opacity-60 hover:opacity-100 transition-opacity" />
          </a>
          <a href="https://www.linkedin.com/in/neal-borowiak/" target="_blank" rel="noopener noreferrer">
            <img src="/linkedin.svg" alt="LinkedIn" class="w-6 h-6 opacity-60 hover:opacity-100 transition-opacity" />
          </a>
          <a href="https://x.com/NealWitIt" target="_blank" rel="noopener noreferrer">
            <img src="/twitter.svg" alt="Twitter" class="w-6 h-6 opacity-60 hover:opacity-100 transition-opacity" />
          </a>
        </div>
      </div>
    </div>
  </nav>
</header> 